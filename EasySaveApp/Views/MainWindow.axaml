<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EasySaveApp.ViewModels"
        xmlns:models="using:EasySave.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1180"
        d:DesignHeight="760"
        x:Class="EasySaveApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="EasySave 2.0 - ProSoft"
        MinWidth="980"
        MinHeight="650"
        Width="1180"
        Height="760"
        Background="#F4F7FB">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="#163B57" Padding="24,18">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="EasySave" FontSize="30" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Backup management console" FontSize="14" Foreground="#C8D8E6"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#245B7D"
                        CornerRadius="6"
                        Padding="14,8"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="1.25*,0.95*"
              RowDefinitions="*"
              Margin="24"
              ColumnSpacing="20">

            <Grid Grid.Row="0"
                  Grid.Column="0"
                  RowDefinitions="*,Auto"
                  RowSpacing="20"
                  MinWidth="0">
                <Border Background="White"
                        BorderBrush="#D8E1EA"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Backup jobs" FontSize="22" FontWeight="Bold" Foreground="#152C3F"/>
                                <TextBlock Text="Create, select, delete and run jobs just like in the console version."
                                           Foreground="#66798A"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Jobs.Count, StringFormat='{}{0} jobs'}"
                                       Foreground="#245B7D"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Jobs}"
                                 SelectedItem="{Binding SelectedJob}"
                                 Margin="0,18,0,18"
                                 Background="#F7FAFD"
                                 BorderBrush="#D8E1EA"
                                 BorderThickness="1"
                                 CornerRadius="6">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:BackupJob">
                                    <Border Padding="12" MinHeight="84">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       Foreground="#152C3F"/>
                                            <Border Grid.Column="1"
                                                    Background="#EAF3F8"
                                                    CornerRadius="4"
                                                    Padding="8,4">
                                                <TextBlock Text="{Binding Type}" Foreground="#245B7D" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding SourceDirectory, StringFormat='Source: {0}'}"
                                                       Margin="0,8,0,0"
                                                       Foreground="#52687A"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding TargetDirectory, StringFormat='Target: {0}'}"
                                                       Margin="0,3,0,0"
                                                       Foreground="#52687A"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                            <Button Content="Run selected"
                                    Command="{Binding RunJobCommand}"
                                    IsEnabled="{Binding IsReady}"
                                    Background="#1F6F9F"
                                    Foreground="White"
                                    Padding="18,10"
                                    CornerRadius="6"/>
                            <Button Content="Run all"
                                    Command="{Binding RunAllJobsCommand}"
                                    IsEnabled="{Binding IsReady}"
                                    Background="#244F38"
                                    Foreground="White"
                                    Padding="18,10"
                                    CornerRadius="6"/>
                            <Button Content="Delete selected"
                                    Command="{Binding DeleteJobCommand}"
                                    IsEnabled="{Binding HasSelectedJob}"
                                    Background="#B94A48"
                                    Foreground="White"
                                    Padding="18,10"
                                    CornerRadius="6"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="White"
                        BorderBrush="#D8E1EA"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Text="Activity" FontSize="18" FontWeight="Bold" Foreground="#152C3F"/>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding ActivityMessages}"
                                 Height="90"
                                 Margin="0,10,0,0"
                                 Background="#F7FAFD"
                                 BorderThickness="0"
                                 HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="0" Grid.Column="1">
                <StackPanel Spacing="20">
                    <Border Background="White"
                            BorderBrush="#D8E1EA"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Create a job" FontSize="22" FontWeight="Bold" Foreground="#152C3F"/>

                            <TextBlock Text="Name" Foreground="#52687A"/>
                            <TextBox Text="{Binding JobName}" Watermark="Daily documents backup"/>

                            <TextBlock Text="Source directory" Foreground="#52687A"/>
                            <TextBox Text="{Binding SourceDirectory}" Watermark="C:\SourceFolder"/>

                            <TextBlock Text="Target directory" Foreground="#52687A"/>
                            <TextBox Text="{Binding TargetDirectory}" Watermark="D:\BackupFolder"/>

                            <TextBlock Text="Backup type" Foreground="#52687A"/>
                            <ComboBox ItemsSource="{Binding BackupTypes}"
                                      SelectedItem="{Binding SelectedBackupType}"
                                      HorizontalAlignment="Stretch"/>

                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                <Button Content="Create"
                                        Command="{Binding CreateJobCommand}"
                                        Background="#1F6F9F"
                                        Foreground="White"
                                        Padding="18,10"
                                        CornerRadius="6"/>
                                <Button Content="Clear"
                                        Command="{Binding ClearFormCommand}"
                                        Padding="18,10"
                                        CornerRadius="6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="White"
                            BorderBrush="#D8E1EA"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Settings" FontSize="22" FontWeight="Bold" Foreground="#152C3F"/>

                            <TextBlock Text="Log format" Foreground="#52687A"/>
                            <ComboBox ItemsSource="{Binding LogFormats}"
                                      SelectedItem="{Binding SelectedLogFormat}"
                                      HorizontalAlignment="Stretch"/>

                            <TextBlock Text="Business software process" Foreground="#52687A"/>
                            <TextBox Text="{Binding BusinessSoftware}" Watermark="calculator.exe"/>

                            <TextBlock Text="Extensions to encrypt" Foreground="#52687A"/>
                            <TextBox Text="{Binding ExtensionsToEncrypt}" Watermark=".txt; .pdf; .docx"/>

                            <TextBlock Text="Crypto key" Foreground="#52687A"/>
                            <TextBox Text="{Binding CryptoKey}" Watermark="EasySave2026"/>

                            <Button Content="Save settings"
                                    Command="{Binding SaveSettingsCommand}"
                                    Background="#1F6F9F"
                                    Foreground="White"
                                    Padding="18,10"
                                    CornerRadius="6"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="#E7EEF5" Padding="24,10">
            <TextBlock Text="Features mirrored from console: create jobs, list jobs, run selected, run all sequentially, delete jobs, configure JSON/XML logs, business software blocking and encryption settings."
                       Foreground="#52687A"/>
        </Border>
    </Grid>
</Window>
